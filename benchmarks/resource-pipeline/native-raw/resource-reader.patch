+private const val ANDROID_RESOURCE_PATH_PREFIX = "compose-android-resource://"
+
+/**
+ * Creates a context-free location for original XML stored in an Android raw resource.
+ *
+ * Intended for generated Android resource accessors. [logicalPath] retains the original
+ * XML path, including qualifiers and extension; callers must not depend on its encoding.
+ * Resource existence is checked when reading, not when constructing the descriptor.
+ */
+@InternalResourceApi
+fun getAndroidResourcePath(resourceId: Int, logicalPath: String): String {
+    require(resourceId != 0) { "An Android raw resource ID must not be zero." }
+    require(logicalPath.endsWith(".xml", ignoreCase = true)) { "An XML resource path is required." }
+    return "$ANDROID_RESOURCE_PATH_PREFIX$resourceId/$logicalPath"
+}
