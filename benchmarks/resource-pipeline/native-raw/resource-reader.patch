+    // Prototype-only location emitted by Android accessors. Construction needs no Context.
+    // The .xml suffix preserves painterResource's existing format selection.
+    private fun nativeResourceId(path: String): Int? {
+        val prefix = "compose-android-resource://"
+        if (!path.startsWith(prefix)) return null
+        val payload = path.removePrefix(prefix)
+        val id = payload.substringBefore('/').toIntOrNull()
+        if (id == null || id <= 0 || payload.substringAfter('/', "") != "drawable.xml") {
+            throwMissingResourceException(path)
+        }
+        return id
