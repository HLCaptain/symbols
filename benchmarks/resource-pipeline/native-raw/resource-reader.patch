+    private fun nativeResourceId(path: String): Int? {
+        if (!path.startsWith(ANDROID_RESOURCE_PATH_PREFIX)) return null
+        val payload = path.removePrefix(ANDROID_RESOURCE_PATH_PREFIX)
+        val id = payload.substringBefore('/').toIntOrNull()
+        if (id == null || id == 0 || !payload.substringAfter('/', "").endsWith(".xml", ignoreCase = true)) {
+            throwMissingResourceException(path)
+        }
+        return id
