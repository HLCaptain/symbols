<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/legacy_views_title"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/plain_xml_label" />

        <ImageView
            android:id="@+id/xml_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/home_icon_description"
            android:src="@drawable/material_symbols_outlined_home_ue9b2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/context_drawable_label" />

        <ImageView
            android:id="@+id/context_drawable_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/search_icon_description" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/view_binding_label" />

        <ImageView
            android:id="@+id/view_binding_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/check_icon_description" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/find_view_by_id_label" />

        <ImageView
            android:id="@+id/find_view_by_id_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/settings_icon_description" />

        <FrameLayout
            android:id="@+id/data_binding_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/custom_view_label" />

        <io.github.hlcaptain.symbols.sample.GeneratedSymbolView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/favorite_icon_description"
            app:symbolDrawable="@drawable/app_icons_rounded_favorite_ue87e" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:drawableStart="@drawable/material_symbols_outlined_settings_ue8b8"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:text="@string/compound_drawable_label" />
    </LinearLayout>
</ScrollView>
